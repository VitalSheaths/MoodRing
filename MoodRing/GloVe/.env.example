# Research feature pipelines (PostgreSQL); no credentials are committed.
DATABASE_URL=postgresql+psycopg2://localhost/postgres
# Paper ledger is separate; can also be a PostgreSQL SQLAlchemy URL.
PAPER_DATABASE_URL=sqlite:///resources/paper_trading.sqlite
# Replace the key with a random secret. It maps to a stable user ID, not a username header.
PAPER_API_USERS_JSON={"replace-with-your-random-secret":"learner"}
# Safe default: fixed synthetic lesson quotes; live requires explicit opt-in.
PAPER_QUOTE_MODE=offline
PAPER_PRICE_CHECK_INTERVAL_S=300
PAPER_ENABLE_PRICE_CHECKER=true
PAPER_MARKET_CACHE=resources/market_cache.json
# Optional: a DISPOSABLE PostgreSQL server with permission to create test databases.
# PAPER_TEST_POSTGRES_URL=postgresql+psycopg2://localhost/postgres
